# Copy this file to ".env" (same folder) and fill in every value.
# .env holds real passwords, so it is in .gitignore and is NEVER committed.

# Port the server listens on. Open http://localhost:3000 in the browser.
PORT=3000

# Secret used to sign login tokens (JWT). Any long random string.
JWT_SECRET=change-this-to-a-long-random-string

# Where MySQL is running.
DB_HOST=localhost
DB_PORT=3306

# Two databases: one for using the app, one that the tests are allowed to wipe.
DB_NAME=givegrid
DB_TEST_NAME=givegrid_test

# The LIMITED account the running app logs in with. "npm run setup" creates it.
# It cannot delete rows anywhere, and cannot change history (donation_events).
DB_APP_USER=givegrid_app
DB_APP_PASSWORD=change-this-app-password

# Your MySQL administrator account (usually root).
# Used ONLY by "npm run setup", "npm run seed" and by the tests to reset tables.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=your-mysql-root-password
